{
  "name": "vanguarddb",
  "productName": "VanguardDB",
  "private": true,
  "version": "0.3.0",
  "description": "Local Cardfight!! Vanguard card database, deck builder, and proxy printer. Browse cards across Vanguard's various eras with full text search, filters, and viewing options. Build decks with real-time legality validation. Print proxy sheets of your saved decks or any of the precon decks built in the app.",
  "author": {"Joseph Pascua <joseph.gabriel.silor.pascua@gmail.com>"},
  "license": "MIT",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "index": "node scripts/build-index.mjs",
    "server": "node server.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:start": "electron .",
    "dist:dir": "npm run index && npm run build && electron-builder --dir",
    "dist:exe": "npm run index && npm run build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.vanguarddb.app",
    "productName": "VanguardDB",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts/",
        "to": "scripts"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "VanguardDB-${version}.exe"
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
